<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_neurogazebo'>
    <include merge='true'>
      <uri>model://x500_base</uri>
    </include>
    <!-- ODM (이동우 박사님 모터 모델, CBNU 시험대 fit, V3 variant) — replaces 4x MulticopterMotorModel.
         PWM->omega_ss (deadband) -> 108ms input delay -> tau(omega) lag ->
         T=kT(omega)*omega^2.  Writes rotor joint velocity so
         NeuroDynamicsPlugin keeps reading omega unchanged.
         See gz_plugin/ActuatorODMPlugin.hh and
         docs/superpowers/specs/2026-05-14-actuator-v3-plugin-design.md -->
    <plugin filename="ActuatorODMPlugin" name="neurogazebo::ActuatorODMPlugin">
      <link_name>base_link</link_name>
      <joint_prefix>rotor_</joint_prefix>
      <num_motors>4</num_motors>
      <!-- DSHOT_C: 0713 DShot 벤치 cloud(n=29590)에서 직접 적합한 concave cubic
           cmd→ω 맵(111.118u³−441.662u²+1329.757u+116.036 rad/s), 곱셈 앵커 없이
           그대로 사용. cmd를 0~1로 역산 후 적용. hover ω(=716.7)는 kT(×0.942)가
           고정하므로 맵은 그 명령점(u≈0.534)만 정함. 뒷단 kT(ω)는 V3 동일.
           (직선판은 variant=DSHOT: 919.9u+201.9.) -->
      <variant>DSHOT_C</variant>
      <!-- physics-v2 (2026-07-20): 무보상 ESC 전압 효과 — 정적맵 입력 = u·(V/V_ref).
           bus_voltage=0 (기본) = off. per-run으로 해당 real 소티의 V̄ 주입.
           V_ref=15.71 (0714 호버앵커 소티). rotor_inertia = 로터 스핀 반작용 Ip·ω̇ [kg·m²],
           0 (기본) = off. 식별 4.3e-5~7.5e-5. docs/odm_real_gap_analysis_2026_07_16.md -->
      <!-- 세션 유효 kT 배율(라벨 kt_scale과 짝, 기본 1.0 = 표준밀도; 특정 real 세션 재현 시에만 세션 kt) -->
      <kt_scale>1.0</kt_scale>
      <bus_voltage>0.0</bus_voltage>
      <bus_voltage_ref>15.71</bus_voltage_ref>
      <rotor_inertia>4.3e-5</rotor_inertia>
      <command_topic>command/motor_speed</command_topic>
      <cmd_min>150</cmd_min>
      <cmd_max>1000</cmd_max>
      <slowdown>10</slowdown>
      <!-- pure transport delay [s]: CBNU bench value is 0.108, but that
           destabilises the PX4 closed-loop attitude controller in SITL.
           tau(omega) still provides realistic actuator lag. -->
      <input_delay>0.0</input_delay>
      <tau_scale>2.0</tau_scale>
      <turning_direction_0>ccw</turning_direction_0>
      <turning_direction_1>ccw</turning_direction_1>
      <turning_direction_2>cw</turning_direction_2>
      <turning_direction_3>cw</turning_direction_3>
    </plugin>
    <!-- NN Residual: real x500 flight-trained (Gz physics residual, k_t*omega^2 based) -->
    <plugin filename="NeuroDynamicsPlugin" name="neurogazebo::NeuroDynamicsPlugin">
      <engine_path>/home/user/neurogazebo/workspace/logs/x500_active/network.trt</engine_path>
      <link_name>base_link</link_name>
      <joint_prefix>rotor_</joint_prefix>
      <num_motors>4</num_motors>
      <history_length>20</history_length>
      <update_rate>100</update_rate>
      <scale_factor>0.0</scale_factor>
      <!-- per-channel A/B (2026-09-03): force/torque residual multipliers on top of
           scale_factor*gate. 1.0/1.0 = legacy. torque-only run = force_scale 0.0. -->
      <force_scale>1.0</force_scale>
      <!-- physics-v4-lite (2026-09-07): NN 모터 입력 ω 배율 = 세션 √kt (밀도 정합). 기본 1.0 = 표준밀도 배포; 특정 real 세션 재현 시에만 사용. -->
      <motor_omega_scale>1.0</motor_omega_scale>
      <!-- 진단용 상수 본체힘 [N, FRD] — NN 힘 경로와 동일 지점에 주입, 기본 0 0 0 = off (§7.8 sim 응답 이득 실험) -->
      <const_force_frd>0 0 0</const_force_frd>
      <torque_scale>1.0</torque_scale>
      <!-- OOD guard: clamp NN inputs to training mean±3σ (normalization.yaml).
           Without it the TCN extrapolates on takeoff ω / off-heading states
           (raw output observed up to 308 N). 0 = off. -->
      <input_clip_sigma>3.0</input_clip_sigma>
      <!-- x500 idle 150 rad/s, hover ~620, max 1000 — disable NN below 300 -->
      <motor_active_threshold>300.0</motor_active_threshold>
      <!-- OOD trust-region gate + output LPF (2026-07-16, eval13 진단 처방②).
           open-loop 학습 잔차의 closed-loop 되먹임 불안정 대응: 입력 클립비율이
           start를 넘으면 게이트가 닫히기 시작, full에서 완전 차단 (끄기 빠르게
           tau_down, 켜기 느리게 tau_up). output_lpf_tau는 잔차 적용 대역 절단.
           이륙(비학습 단계) 시드와 선회 발산 나선을 자기제한. 0/미기재 = 비활성. -->
      <ood_gate_start>0.05</ood_gate_start>
      <ood_gate_full>0.20</ood_gate_full>
      <gate_tau_up>1.0</gate_tau_up>
      <gate_tau_down>0.1</gate_tau_down>
      <output_lpf_tau>0.5</output_lpf_tau>
      <!-- NN trained on PX4 FRD body / NED world (extract_px4_ulg.py output).
           Plugin converts FLU↔FRD body and ENU↔NED world internally.
           See gz_plugin/NeuroDynamicsPlugin.hh and GitHub issue #6. -->
      <training_frame>frd</training_frame>
    </plugin>
    <!-- RPG linear rotor drag (0609 real fit). ODM has no velocity term. -->
    <plugin filename="RotorDragPlugin" name="neurogazebo::RotorDragPlugin">
      <link_name>base_link</link_name>
      <drag_x>0.191</drag_x>
      <drag_y>0.223</drag_y>
      <drag_z>0.0</drag_z>
      <mass>2.134</mass>
      <motor_active_threshold>100</motor_active_threshold>
      <!-- DEPRECATED & REMOVED (2026-07-07 결정): gust_sigma_u/v/w, gust_length —
           파싱 유실 + 효과 불충분으로 폐기 (상세: docs/motor_vibration_imu/sim_vibration_model.md §4.5).
           yaw_bias_torque는 2026-07-15 **재이식**: 06-18/07-14 호버 실측이 ~0.043 N·m
           대각쌍 트림(CCW쌍 고속)을 견고하게 재확인 → RotorDragPlugin에 파싱 복원.
           FLU body +z 상수 토크, 모터 gate 뒤에만 적용.
           2026-07-15 기본값 0.043 활성화: ① 호버 실측 트림 재현 검증(모터별 ω ~1.5% 일치,
           u RMS gap 2.7배↓), ② active NN(x500_TCN_20260707)이 cgyaw-포함 physics 잔차로
           학습됨 → 대칭 sim에선 이 토크가 물리에도 NN에도 없어 통째로 비는 전제조건 위반,
           ③ NN 입력 ω의 per-motor 분포 정렬(대각쌍 분리 88 rad/s). 0으로 두면 대칭(ablation용). -->
      <yaw_bias_torque>0.043</yaw_bias_torque>
      <!-- physics-v3 (2026-08-05): M8 포화형 flapping이 상수 k_flap을 대체.
           τ_xy = k_axis·(ω̄/ω_ref)⁻¹·(ẑ×v)/(1+c·v_hor)  (T3c 프로브 2026-08-03).
           상수 0.0867은 고속에서 τxy 50~90% 과대주입(edge holdout R² 0.575 vs
           M8 0.859) — flapping_probe_2026_08_03.md §T0-c.  라벨 짝: dshot_v3
           (real_x500_comb_v3_0609out_0714in).  k_flap=0 유지(레거시 상수형 off;
           roll/pitch 둘 다 0으로 두면 M8 off → 상수형으로 복귀 가능). -->
      <k_flap>0.0</k_flap>
      <k_flap_roll>0.130</k_flap_roll>
      <k_flap_pitch>0.163</k_flap_pitch>
      <k_flap_c>0.19</k_flap_c>
      <k_flap_omega_ref>700.0</k_flap_omega_ref>
      <!-- airspeed-dependent vibration noise (aero buffeting): stddev = vib_gain*|v_body| [N.m].
           real gyro noise grows ~linearly with airspeed (0609 fit). 0 = stock white floor only.
           (2026-07-07 재이식됨 — staticvib 비교군용. 상태의존 진동은 ImuVibrationPlugin 사용.
            기본값 0.0: 파서 유실 기간의 실효 거동(no-vib) 보존 — 배치가 config별로 명시 설정) -->
      <vib_gain>0.0</vib_gain>
    </plugin>
    <!-- State-dependent IMU vibration (2026-07-06/07 vibration-model work; merged from the
         retired x500_neurogazebo_vib model 2026-07-07 — one model, toggled here).
         sigma_ch = a0 + a1*|v| + a2*omega per body axis (accel m/s^2, gyro rad/s HP-RMS),
         omega = mean rotor JointVelocity*slowdown [rad/s], |v| = world speed [m/s].
         Coefficients = [10,125] Hz BAND-LIMITED refit of the 2026-06-09 real drag campaign
         (workspace/vibration_model/results/fit_band125.json; regenerate the block below with
         fit_band125.py). Band-limited because the 250 Hz sim IMU chain (Nyquist 125 Hz)
         cannot express blade-pass content — full-band coefficients would over-inject into
         the EKF band. If the world/IMU rate changes, refit for the new band first.
         Mechanism: subscribes the raw gz IMU topic, adds 10 Hz-highpassed shaped noise,
         republishes on ".../imu_vib"; GZBridge dual-subscribe prefers imu_vib, falls back
         to raw if this plugin is absent.
         <enable>0</enable> (DEFAULT) = PASS-THROUGH republish: byte-equivalent IMU data,
         no injection — stock behaviour preserved for all existing airframes/batches.
         Enable by setting <enable>1</enable> (ablation batch scripts sed this tag; see
         scripts/_batch_vibmodel_0706.sh and auto_logs/vibmodel_0706/README.md).
         Validation: closed-loop 18-sortie ablation vs real 0609 — injection 36/36 cells
         within ±20% of target, realism 30/36 cells within ±20% of REAL
         (docs/motor_vibration_imu/sim_vibration_model.md §4.5). -->
    <plugin filename="ImuVibrationPlugin" name="neurogazebo::ImuVibrationPlugin">
      <link_name>base_link</link_name>
      <joint_prefix>rotor_</joint_prefix>
      <num_motors>4</num_motors>
      <slowdown>10</slowdown>
      <sensor_name>imu_sensor</sensor_name>
      <enable>0</enable>
      <seed>42</seed>
      <hp_cutoff_hz>10</hp_cutoff_hz>
      <imu_rate_hz>250</imu_rate_hz>
      <omega_min_inject>100</omega_min_inject>
      <omega_scale>1.0</omega_scale>
      <omega_offset>0.0</omega_offset>
      <sigma_max_accel>20.0</sigma_max_accel>
      <sigma_max_gyro>1.0</sigma_max_gyro>
      <debug_decimation>25</debug_decimation>
      <!-- auto-generated by fit_band125.py -- [10,125] Hz band-limited vibration coefficients -->
      <acc_x_a0>0.531408</acc_x_a0>
      <acc_x_a1>0.341802</acc_x_a1>
      <acc_x_a2>0.00237529</acc_x_a2>
      <acc_y_a0>0.868168</acc_y_a0>
      <acc_y_a1>0.218804</acc_y_a1>
      <acc_y_a2>0.00247435</acc_y_a2>
      <acc_z_a0>0.445378</acc_z_a0>
      <acc_z_a1>0.535907</acc_z_a1>
      <acc_z_a2>0.00120188</acc_z_a2>
      <gyr_x_a0>0.0165256</gyr_x_a0>
      <gyr_x_a1>0.00404074</gyr_x_a1>
      <gyr_x_a2>2.6625e-05</gyr_x_a2>
      <gyr_y_a0>0.0087708</gyr_y_a0>
      <gyr_y_a1>0.0055574</gyr_y_a1>
      <gyr_y_a2>3.7258e-06</gyr_y_a2>
      <gyr_z_a0>0.00824181</gyr_z_a0>
      <gyr_z_a1>0.00230386</gyr_z_a1>
      <gyr_z_a2>2.8941e-06</gyr_z_a2>
    </plugin>
  </model>
</sdf>
