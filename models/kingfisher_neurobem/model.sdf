<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='kingfisher_neurobem'>
    <include merge='true'>
      <uri>model://kingfisher_base</uri>
    </include>
    <!-- Motor 0: front-right, CCW
         MulticopterMotorModel is kept ONLY for motor velocity simulation
         (joint spinning). BEM plugin handles all force/torque computation.
         Set motorConstant=0 and momentConstant=0 to disable force output. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2800.0</maxRotVelocity>
      <motorConstant>0.0</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <!-- Motor 1: back-left, CCW -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2800.0</maxRotVelocity>
      <motorConstant>0.0</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <!-- Motor 2: front-left, CW -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2800.0</maxRotVelocity>
      <motorConstant>0.0</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <!-- Motor 3: back-right, CW -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>2800.0</maxRotVelocity>
      <motorConstant>0.0</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <!-- BEM Aerodynamics: Blade Element Momentum force/torque computation -->
    <plugin filename="BEMMotorPlugin" name="neurogazebo::BEMMotorPlugin">
      <link_name>base_link</link_name>
      <joint_prefix>rotor_</joint_prefix>
      <num_motors>4</num_motors>
    </plugin>
    <!-- NN Residual Dynamics: TensorRT inference for BEM residual correction -->
    <plugin filename="NeuroDynamicsPlugin" name="neurogazebo::NeuroDynamicsPlugin">
      <engine_path>/home/user/neurogazebo/workspace/logs/20260320-104106_bem-nn-body/best_model/network.trt</engine_path>
      <link_name>base_link</link_name>
      <joint_prefix>rotor_</joint_prefix>
      <num_motors>4</num_motors>
      <history_length>20</history_length>
      <update_rate>400</update_rate>
      <scale_factor>1.0</scale_factor>
    </plugin>
  </model>
</sdf>
